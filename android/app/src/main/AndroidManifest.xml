<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      CHANGE_NETWORK_STATE: required by ConnectivityManager.requestNetwork(),
      which throws SecurityException without it. It is a normal permission,
      granted at install time with no runtime prompt. (getAllNetworks() and
      bindProcessToNetwork() only need ACCESS_NETWORK_STATE, so NetworkBinder
      still has a fallback path if this one is denied.)
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!--
      REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: shows the system "ignore battery
      optimizations" dialog. A foreground service only survives stock Doze, not
      vendor ROM power savers (Xiaomi, Huawei, OPPO, ...), which freeze the
      network of background apps: the tunnel works while the app is in the
      foreground and drops as soon as it goes to the background. Only the
      allowlist keeps it alive.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Wake lock: keeps the tunnel goroutines and sockets alive with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires a declared foreground service type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ requires a runtime request for notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Burrow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TunnelService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
